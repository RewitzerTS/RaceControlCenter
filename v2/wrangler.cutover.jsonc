{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "racevora-v2-production",
  "main": "./worker/news-worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": true,
  "send_email": [{ "name": "FEEDBACK_EMAIL", "allowed_sender_addresses": ["beta-feedback@racevora.com"] }],
  "ratelimits": [
    { "name": "FEEDBACK_RATE_LIMIT", "namespace_id": "2026090201", "simple": { "limit": 3, "period": 60 } },
    { "name": "FEEDBACK_GLOBAL_LIMIT", "namespace_id": "2026090202", "simple": { "limit": 30, "period": 60 } }
  ],
  "routes": [
    {
      "pattern": "racevora.com/*",
      "zone_name": "racevora.com"
    },
    {
      "pattern": "www.racevora.com/*",
      "zone_name": "racevora.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*"]
  }
}
