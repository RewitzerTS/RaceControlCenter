{
  "name": "racevora-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "isolation": "node scripts/assert-isolation.mjs",
    "database-contract": "node scripts/assert-database-foundation.mjs",
    "driver-identity-contract": "node scripts/assert-driver-identity.mjs",
    "role-model-contract": "node scripts/assert-role-model.mjs",
    "result-versioning-contract": "node scripts/assert-result-versioning.mjs",
    "domain-events-contract": "node scripts/assert-domain-events.mjs",
    "career-engine-contract": "node scripts/assert-career-engine.mjs",
    "xp-level-rank-contract": "node scripts/assert-xp-level-rank.mjs",
    "achievements-contract": "node scripts/assert-achievements.mjs",
    "credits-garage-contract": "node scripts/assert-credits-garage.mjs",
    "challenges-contract": "node scripts/assert-challenges.mjs",
    "i18n-contract": "node scripts/assert-i18n.mjs",
    "driver-experience-contract": "node scripts/assert-driver-experience.mjs",
    "steward-experience-contract": "node scripts/assert-steward-experience.mjs",
    "operations-contract": "node scripts/assert-operations.mjs",
    "vora-contract": "node scripts/assert-vora.mjs",
    "social-graphics-contract": "node scripts/assert-social-graphics.mjs",
    "demo-full-e2e-contract": "node scripts/assert-demo-full-e2e.mjs",
    "user-journey-e2e-contract": "node scripts/assert-user-journeys.mjs",
    "security-gate-contract": "node scripts/assert-security-gate.mjs",
    "migration-rehearsal-contract": "node scripts/assert-migration-rehearsal.mjs",
    "beta-access-contract": "node scripts/assert-beta-access.mjs",
    "v1-recovery-gate": "node scripts/assert-v1-recovery-gate.mjs",
    "verify": "npm run check && npm run test && npm run isolation && npm run database-contract && npm run driver-identity-contract && npm run role-model-contract && npm run result-versioning-contract && npm run domain-events-contract && npm run career-engine-contract && npm run xp-level-rank-contract && npm run achievements-contract && npm run credits-garage-contract && npm run challenges-contract && npm run i18n-contract && npm run driver-experience-contract && npm run steward-experience-contract && npm run operations-contract && npm run vora-contract && npm run social-graphics-contract && npm run demo-full-e2e-contract && npm run user-journey-e2e-contract && npm run security-gate-contract && npm run migration-rehearsal-contract && npm run beta-access-contract && npm run v1-recovery-gate && npm run build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
